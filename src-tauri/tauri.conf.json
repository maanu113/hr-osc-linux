{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hr-osc",
  "version": "0.3.2",
  "identifier": "me.kamyu.hr-osc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 250,
        "resizable": false,
        "title": "hr-osc",
        "width": 325
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "kamyu",
    "icon": ["icons/icon.png"],
    "shortDescription": "Heart rate OSC bridge for VRChat",
    "targets": ["deb", "rpm"]
  }
}
